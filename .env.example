# FastAPI application
PROJECT_TITLE="Plan-naryad API"           # Human-readable API title shown in Swagger
PROJECT_HOST=0.0.0.0                       # Bind host for uvicorn
PROJECT_PORT=8090                          # Bind port for uvicorn
PROJECT_DOCS_VERSION=1.0.0                 # API version displayed in Swagger
PROJECT_DOCS_URL=/api/openapi              # Swagger UI path
PROJECT_OPENAPI_URL=/api/openapi.json      # OpenAPI schema path

# PostgreSQL — runtime database connection
DB_DRIVER_NAME=postgresql+asyncpg          # SQLAlchemy driver name
DB_HOST=localhost                          # Database host
DB_PORT=5433                               # Database port
DB_NAME=plan_naryad                        # Database name
DB_USER=pn_user                            # Database user
DB_PASS=pn_secret                          # Database password
DB_SHOW_QUERIES=false                      # Echo SQL statements into stdout (dev only)

# PostgreSQL — automated tests
DB_TEST_DATABASE_NAME=plan_naryad_test     # Dedicated DB name for pytest runs (recreated every run)

# Business logic
MAX_ITEMS_PER_CONTRACTOR=10                # Max plan items per contractor per day

# Keycloak — shared connection (used by both Bearer auth and Raport client)
KEYCLOAK_SERVER_URL=                       # Base URL of the Keycloak server, e.g. https://keycloak.example.com
KEYCLOAK_REALM=                            # Keycloak realm name
KEYCLOAK_VERIFY_SSL=true                   # Set false for dev Keycloak with a self-signed cert

# Keycloak Bearer-token auth (optional — set AUTH_ENABLED=true to activate)
AUTH_ENABLED=false                         # Enable JWT Bearer auth on all non-public routes
KEYCLOAK_CLIENT_ID=                        # Client id used for token introspection
KEYCLOAK_CLIENT_SECRET=                    # Client secret (fill in .env only, not here)

# Raport ecosystem — external data source
REPORT_API_URL=                            # Base URL of the main Raport service (no /api/v1)
REPORT_KEYCLOAK_CLIENT_ID=                 # Keycloak client id for the service account
REPORT_KEYCLOAK_CLIENT_SECRET=             # Keycloak client secret (fill in .env only, not here)
REPORT_KEYCLOAK_USERNAME=                  # Technical Keycloak user for password-grant auth
REPORT_KEYCLOAK_PASSWORD=                  # Technical user's password (fill in .env only, not here)
