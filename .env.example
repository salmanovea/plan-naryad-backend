# FastAPI application
PROJECT_TITLE="Plan-naryad API"           # Human-readable API title shown in Swagger
PROJECT_HOST=0.0.0.0                       # Bind host for uvicorn
PROJECT_PORT=8090                          # Bind port for uvicorn
PROJECT_API_PREFIX=/api                    # API path prefix
PROJECT_DOCS_VERSION=1.0.0                 # API version displayed in Swagger
PROJECT_DOCS_URL=/openapi              # Swagger UI path
PROJECT_OPENAPI_URL=/openapi.json      # OpenAPI schema path

# PostgreSQL — runtime database connection
DB_DRIVER_NAME=postgresql+asyncpg          # SQLAlchemy driver name
DB_HOST=localhost                          # Database host
DB_PORT=5433                               # Database port
DB_NAME=plan_naryad                        # Database name
DB_USER=pn_user                            # Database user
DB_PASS=pn_secret                          # Database password
DB_SHOW_QUERIES=false                      # Echo SQL statements into stdout (dev only)

# PostgreSQL — automated tests
DB_TEST_DATABASE_NAME=plan_naryad_test     # Dedicated DB name for pytest runs (recreated every run)

# Business logic
MAX_ITEMS_PER_CONTRACTOR=10                # Max plan items per contractor per day

# Keycloak — connection params of the Raport client (this service has no client of its own)
KEYCLOAK_SERVER_URL=                       # Base URL of the Keycloak server, e.g. https://keycloak.example.com
KEYCLOAK_REALM=                            # Keycloak realm name
KEYCLOAK_VERIFY_SSL=true                   # Set false for dev Keycloak with a self-signed cert

# Authentication (src/middlewares/raport_auth): tokens are verified against Keycloak's keys,
# permissions come from Raport. See docs/auth.md.
AUTH_ENABLED=false                         # Enable Bearer auth on all non-public routes
AUTH_ALLOWED_GROUPS=superuser,plan_naryad  # Raport groups allowed in; empty is a startup error when auth is on
AUTH_SERVICE_CLIENTS=                      # Keycloak client ids (azp) of machine callers — Raport's REPORT_CLIENT_ID
AUTH_AUTHZ_MODE=users-me                   # 'authz' needs REPORT_KEYCLOAK_CLIENT_ID with service accounts enabled
                                           # and listed in Raport's SERVICE_CLIENT_IDS
# Defaults below are good as they are:
# AUTH_EXPECTED_AUDIENCE=                  # Required `aud`; empty = no audience check (no mapper in Keycloak yet)
# AUTH_AUTHZ_PATH=/api/v1/authz/users/{keycloak_id}
# AUTH_ME_PATH=/api/v1/users/me
# AUTH_CACHE_TTL=120                       # Seconds a permissions answer is reused (never outlives the token)
# AUTH_NEGATIVE_CACHE_TTL=15               # Seconds a refusal is remembered
# AUTH_JWKS_TTL=3600                       # Seconds Keycloak signing keys are reused
# AUTH_TIMEOUT=10                          # Timeout of outbound auth calls, seconds
# AUTH_REQUIRE_ACTIVE=true                 # Reject users Raport marks inactive

# Admin UI (SQLAdmin at /pn/admin) — signs in through Keycloak SSO, superuser group only
ADMIN_KEYCLOAK_CLIENT_ID=                  # Public frontend client (report-front-client); required when AUTH_ENABLED=true
ADMIN_SESSION_SECRET=                      # Random string; without it admin sessions die on restart
# ADMIN_ALLOWED_GROUPS=superuser           # Raport groups allowed into the admin
# ADMIN_SESSION_TTL=3600                   # Seconds before a silent re-entry through Keycloak re-reads the groups

# Redis — shared cache of authorization answers
REDIS_URL=redis://localhost:6379

# CORS
CORS_ALLOW_ORIGINS=*                       # Comma-separated origins, e.g. https://report.dev.fsk.ru

# Raport ecosystem — external data source
REPORT_API_URL=                            # Base URL of the main Raport service (no /api/v1)
REPORT_KEYCLOAK_CLIENT_ID=                 # Keycloak client id for the service account
REPORT_KEYCLOAK_CLIENT_SECRET=             # Keycloak client secret (fill in .env only, not here)
REPORT_KEYCLOAK_USERNAME=                  # Technical Keycloak user for password-grant auth
REPORT_KEYCLOAK_PASSWORD=                  # Technical user's password (fill in .env only, not here)
REPORT_SERVICE_CLIENT_ID=                  # Confidential client with service accounts, for Raport's /authz
REPORT_SERVICE_CLIENT_SECRET=              # Its secret (fill in .env only). Empty = reuse the client above
